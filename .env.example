# Copy this file to .env and fill in the values from your Firebase project's
# Web App config (Project settings > Your apps > the </> Web app) -- see
# docs/ARCHITECTURE.md "Firestore sync" for the full step-by-step setup.
#
# Vite only exposes variables prefixed with VITE_ to client code.
#
# NEVER put real values in THIS file -- it's the template that gets shared/
# committed. Real values belong only in .env (already gitignored).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
